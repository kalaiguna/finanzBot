# finanzbot — required environment variables
# Copy to .env for local testing; on Cloud Run these are injected via Secret Manager.

# Telegram Bot API token — obtain from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini 2.0 Flash API key — obtain from aistudio.google.com
GEMINI_API_KEY=

# Turso Edge SQLite — obtain from turso.tech dashboard
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Your Telegram numeric user ID — obtain from @userinfobot
ALLOWED_TELEGRAM_USER_ID=

# Set automatically by Cloud Run; override locally for testing
PORT=8080
